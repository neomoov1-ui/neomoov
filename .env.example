# Variables d'environnement de la plateforme Neomoov. Aucune valeur ici.
# Copier en .env (jamais commité) et remplir. Voir la section 3.6 du cahier des charges et
# docs/comptes-externes.md pour l'origine de chaque clé. Une valeur vide équivaut à une variable absente.

# --- Application ---
NODE_ENV=
PORT=
APP_BASE_URL=
WEB_BASE_URL=
# Origines autorisées par CORS, séparées par des virgules ; vide : WEB_BASE_URL seulement
CORS_ORIGINS=
# trace, debug, info (défaut), warn, error, fatal
LOG_LEVEL=
TIMEZONE=
# Adresse de l'API vue du navigateur (web, exposée au client) ; vide : http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=
# Adresse de l'API vue du serveur web (réseau interne) pour la passerelle de My Hub ; vide : NEXT_PUBLIC_API_BASE_URL
API_INTERNAL_URL=
# Clé d'API à portée public:write utilisée par le serveur web pour les devis, adresses et prospects des pages publiques
NEOMOOV_PUBLIC_API_KEY=
# Sites autorisés à intégrer /reserver en iframe (séparés par des espaces) ; vide : https://neomoov.net https://www.neomoov.net
BOOKING_FRAME_ANCESTORS=
# Adresse de l'API pour l'application mobile (publique, fixée par profil dans apps/mobile-client/eas.json) ; vide : http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=
# Projet EAS d'une application mobile (UUID, un projet par application : client et chauffeur ont chacun le leur), lu par
# apps/mobile-*/app.config.ts au build et à la publication d'une mise à jour à la volée ; à poser dans le shell avant
# les commandes eas et dans les variables d'environnement de chaque projet EAS ; vide : mises à jour désactivées
EAS_PROJECT_ID=
# Répartition automatique des courses : auto (défaut) ou manual (opérateur et tests) ; battement en millisecondes, 0 = aucun
DISPATCH_MODE=
DISPATCH_TICK_MS=

# --- Base de données et Redis ---
# DATABASE_URL : adresse « Session pooler » de Supabase (IPv4), ou base locale (infra/docker-compose.yml)
DATABASE_URL=
# Base de test (schéma dédié ou base séparée) ; vide : les tests d'intégration utilisent DATABASE_URL
TEST_DATABASE_URL=
# Connexions simultanées à la base par processus ; vide : 10 (2 en test). Le « Session pooler » de Supabase limite le total
DATABASE_POOL_MAX=
# Vide : files et cache en mémoire (développement seulement) ; obligatoire en production
REDIS_URL=

# --- Secrets de l'application (obligatoires en production, 32 caractères au moins : openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# --- Adaptateurs : "mock" ou "real" ---
# Paiements : mock, stripe (ou real), square (compte Square canadien en attendant la validation du compte Stripe)
PAYMENT_PROVIDER=
MAPS_PROVIDER=
SMS_PROVIDER=
EMAIL_PROVIDER=
PUSH_PROVIDER=
WHATSAPP_PROVIDER=
VOICE_PROVIDER=
LLM_PROVIDER=
SEV_PROVIDER=
STORAGE_PROVIDER=
VIRUS_SCANNER_PROVIDER=
CLAMAV_HOST=
CLAMAV_PORT=
# Vérification des jetons Apple et Google : mock (jetons « mock-apple:<sujet>:<courriel> ») ou real
SOCIAL_LOGIN_PROVIDER=

# --- Connexion Apple et Google (audience des jetons d'identité, séparés par des virgules) ---
# Apple : bundle ids des applications (com.neomoov.client, com.neomoov.driver) et identifiant de service web
APPLE_CLIENT_IDS=
# Google : client ids OAuth (iOS, Android, web)
GOOGLE_CLIENT_IDS=
# Nom affiché dans les applications d'authentification pour le second facteur de My Hub ; vide : Neomoov My Hub
MFA_ISSUER=

# --- Paiements (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Facturation de la plateforme (Stripe Billing), étape 25 : voir docs/platform-billing.md ---
# mock (défaut : abonnements et factures des organisations simulés) ou real (API de Stripe, clé STRIPE_SECRET_KEY ci-dessus)
BILLING_PROVIDER=
# Secret de signature (whsec_...) du point de terminaison https://<api>/v1/webhooks/stripe-billing, distinct de STRIPE_WEBHOOK_SECRET
STRIPE_BILLING_WEBHOOK_SECRET=
# --- Paiements (Square, PAYMENT_PROVIDER=square) ---
# Tableau de bord des développeurs Square, application Neomoov. Voir docs/runbooks/square.md
# sandbox ou production ; vide : production quand NODE_ENV=production, sinon sandbox
SQUARE_ENVIRONMENT=
# Production : jeton d'accès (EAAA…), identifiant d'application (sq0idp-…), emplacement qui encaisse en CAD (L…)
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# Bac à sable : jeton d'accès du bac à sable (EAAA…, pas l'identifiant d'application), identifiant d'application
# (sandbox-sq0idb-…) et emplacement du bac à sable
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_LOCATION_ID=
# Point de réception des webhooks : clé de signature et adresse publique déclarée chez Square (https://…/v1/webhooks/square)
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# --- Cartes (Google Maps Platform) ---
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=

# --- Textos : Telnyx, ou Twilio ---
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Courriels : Resend, ou Brevo ---
# Cloudflare Turnstile : clé secrète (API) et clé de site (pages web, publique)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
BREVO_API_KEY=

# --- WhatsApp Business (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Agent vocal (Vapi) : clé privée, secret du webhook (openssl rand -hex 16, posé chez Vapi par vapi:setup), numéro importé (affiché par vapi:setup) ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER_ID=
# Direction commerciale (phase 1 « entreprise autonome ») : assistant Vapi commercial (docs/voice-agent.md, section « Assistant commercial »)
# et numéro Twilio sortant dédié aux appels de prospection, importé dans Vapi ; vides : aucun appel sortant commercial
VAPI_SALES_ASSISTANT_ID=
VAPI_SALES_PHONE_NUMBER_ID=

# --- Agenda du fondateur (Google Calendar), rendez-vous pris par l'agent commercial : voir docs/sales/prospection.md ---
# mock (défaut : événements simulés) ou real (API Google Calendar)
CALENDAR_PROVIDER=
# Client OAuth « application installée » de la console Google Cloud et jeton de rafraîchissement obtenu une fois (secrets)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Agenda visé (courriel du fondateur) ; vide : agenda principal du compte
GOOGLE_CALENDAR_ID=

# --- Agents IA (Anthropic) ---
ANTHROPIC_API_KEY=
# Repli côté serveur de l'API Claude quand un modèle décline (on par défaut, off pour le couper)
LLM_SERVER_FALLBACK=
# Déclencheurs des agents (messages, documents, relevés, rapports) : on par défaut, off en test sauf le fichier des agents
AGENT_TRIGGERS=
# Test optionnel contre l'API Claude réelle, jamais lancé par défaut : RUN_LLM_TESTS=1 dans l'environnement du test

# --- Stockage des documents : S3 compatible (Supabase Storage), ou Cloudflare R2 ---
# --- Examen des applications par Apple et Google : numéros déclarés et code fixe (6 chiffres), vider après la publication ---
# Paiement par carte proposé (on, off) ; vide : jamais en production avec le fournisseur simulé (PAYMENT_PROVIDER=mock)
# Production : fournisseurs laissés simulés, un par un (payment,maps,sms,email,push,whatsapp,voice,llm,sev,storage,antivirus,crm,billing,calendar,marketing) ;
# tout autre fournisseur simulé empêche le démarrage (ex. bêta : payment,sev,whatsapp,voice)
ALLOW_MOCK_PROVIDERS=

# Documentation OpenAPI sur /v1/docs (on, off) ; vide : fermée en production
API_DOCS=

CARD_PAYMENTS=

# Clé des dérivations durables (codes QR des factures, pseudonymes de géolocalisation) ; vide : ENCRYPTION_KEY. Voir docs/runbooks/secrets-et-cles.md
DERIVATION_KEY=

REVIEW_PHONES=
REVIEW_OTP_CODE=

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Observabilité ---
# Suivi des erreurs (Sentry) de l'API et du worker : actif seulement si le DSN est renseigné (projet Sentry « api »)
SENTRY_DSN=
# Environnement annoncé au suivi des erreurs et par GET /v1/health (staging, production) ; vide : NODE_ENV
SENTRY_ENVIRONMENT=
# Version déployée (étiquette ou empreinte Git) ; vide : version du paquet
APP_VERSION=
# Suivi des erreurs du web, navigateur et serveur Next.js (projet Sentry « web ») : DSN public, inscrit au build
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_APP_VERSION=
# Suivi des erreurs des applications mobiles (projet Sentry « mobile ») : DSN public, fixé par profil EAS
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Journaux vers Better Stack (source « neomoov-api »)
BETTERSTACK_TOKEN=
# Moniteur « heartbeat » Better Stack du worker (adresse secrète, appelée chaque minute) ; vide : aucun appel
BETTERSTACK_HEARTBEAT_URL=

# --- Compilations mobiles (Expo) ---
EXPO_TOKEN=
EXPO_PUSH_ACCESS_TOKEN=

# --- Facturation certifiée (SEV) ---
SEV_API_KEY=

# --- CRM (HubSpot), étape 25 : voir docs/crm.md ---
# mock (défaut : rien ne quitte la plateforme) ou real (HubSpot)
CRM_PROVIDER=
# Jeton de l'application privée HubSpot (Paramètres, Intégrations, Applications privées) : secret
HUBSPOT_ACCESS_TOKEN=
# Numéro de compte HubSpot (Hub ID), non secret : liens affichés par pnpm --filter @neomoov/api crm:setup
HUBSPOT_PORTAL_ID=

# --- Drapeaux de fonctionnalités : on / off (off par défaut) ---
FEATURE_NEGOTIATION=
FEATURE_NEGOTIATION_ABOVE_MAX=
FEATURE_FACE_CHECK=
FEATURE_SCHEDULED_FLIGHT_TRACKING=
FEATURE_IMMEDIATE_RIDES=
FEATURE_INSTALLMENTS=
FEATURE_RIDE_SERIES=

# --- Outils de test (facultatif) : jeu de bout en bout et charge, voir docs/testing/README.md ---
# pnpm seed:e2e : connexions à la base (défaut 8) et traitements en parallèle (défaut 6)
SEED_E2E_POOL=
SEED_E2E_CONCURRENCY=
# pnpm test:load : chemin du binaire k6 (sinon k6 dans le PATH) ; les paramètres LOAD_* se passent à la commande
K6_BIN=

# Sauvegarde logique chiffrée du serveur (infra/scripts/backup.sh) : phrase secrète et destination rclone facultative
BACKUP_PASSPHRASE=
BACKUP_REMOTE=

# Étape 21, développement seulement : on rend aussi le jeton d'une invitation à la personne qui invite (ignoré en production)
INVITATION_TOKEN_IN_RESPONSE=

# --- Boîte de réception unifiée (phase 1 « entreprise autonome », 2 octobre 2026) : voir docs/runbooks/boite-unifiee.md ---
# Relais entrant Brevo (« inbound parsing ») vers https://<api>/v1/webhooks/email : secret partagé, dans l'adresse (?secret=…) ou l'en-tête x-inbound-secret ; absent : relais refusé
EMAIL_INBOUND_SECRET=
# Lecture IMAP de la boîte contact@ (repli du relais entrant) : mock (défaut, rien n'est lu) ou real (imapflow, TLS) ; hôte, port (993), compte, mot de passe, dossier (INBOX)
MAILBOX_PROVIDER=
MAILBOX_HOST=
MAILBOX_PORT=
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_FOLDER=
# Messages et commentaires Meta (Messenger, Facebook, Instagram) : mock (défaut : webhooks refusés hors test, relais humain seul) ou real (API Graph,
# même application Meta que WhatsApp : WHATSAPP_VERIFY_TOKEN et WHATSAPP_APP_SECRET) ; jeton d'accès de la page, identifiant de la page, compte Instagram professionnel
SOCIAL_PROVIDER=
META_PAGE_ID=
META_PAGE_TOKEN=
META_INSTAGRAM_ID=
# --- Marketing automatisé (phase 1 « entreprise autonome », 2 octobre 2026) : voir docs/marketing/connecteurs.md ---
# mock (défaut : onze espaces, site, voix et Search Console simulés) ou real (WordPress, Brevo, Meta selon les clés ;
# les autres espaces refusent clairement tant que leur connecteur n'est pas livré). En production, un mode mock se déclare dans ALLOW_MOCK_PROVIDERS (alias marketing)
MARKETING_PROVIDER=
# Site WordPress (neomoov.net et neomoov.net/academy) : adresse, utilisateur et mot de passe d'application (secret)
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
# Identifiants (slug) des catégories des articles du blogue et de l'Academy ; vide : sans catégorie
WORDPRESS_BLOG_CATEGORY=
WORDPRESS_ACADEMY_CATEGORY=
# Champs des balises de référencement : neomoov (défaut, outil du site) ou yoast
WORDPRESS_SEO_META=
# Infolettre Brevo (campagnes en brouillon, même clé BREVO_API_KEY que l'Academy) : liste des abonnés, expéditeur vérifié
BREVO_NEWSLETTER_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Meta (marketing) : META_PAGE_ID et META_PAGE_TOKEN sont communs avec la boîte unifiée (plus haut) ; compte Instagram professionnel pour publier, version de l'API Graph (v21.0)
META_IG_USER_ID=
META_GRAPH_VERSION=
# Google Search Console : propriété (https://neomoov.net/ ou sc-domain:neomoov.net), compte de service autorisé (courriel et clé privée, secret)
SEARCH_CONSOLE_SITE_URL=
SEARCH_CONSOLE_CLIENT_EMAIL=
SEARCH_CONSOLE_PRIVATE_KEY=
# Voix de synthèse des vidéos courtes : piper (binaire et modèles sur le serveur) ou azure (clé Speech, secret)
TTS_ENGINE=
PIPER_BIN=
PIPER_MODEL=
PIPER_MODEL_EN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Rendu des visuels (navigateur sans interface : chromium, google-chrome ou msedge) et montage vidéo (ffmpeg) ; vide : différé
BROWSER_BIN=
FFMPEG_BIN=
# Connecteurs prévus, non livrés (variables réservées, droits à demander) : LinkedIn, TikTok, YouTube, X, Fiche Google, Snapchat
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_LOCATION_ID=
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_PROFILE_ID=
