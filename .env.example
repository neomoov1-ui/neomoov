# Variables d'environnement de la plateforme Neomoov. Aucune valeur ici.
# Copier en .env (jamais commité) et remplir. Voir la section 3.6 du cahier des charges et
# docs/comptes-externes.md pour l'origine de chaque clé. Une valeur vide équivaut à une variable absente.

# --- Application ---
NODE_ENV=
PORT=
APP_BASE_URL=
WEB_BASE_URL=
# Origines autorisées par CORS, séparées par des virgules ; vide : WEB_BASE_URL seulement
CORS_ORIGINS=
# trace, debug, info (défaut), warn, error, fatal
LOG_LEVEL=
TIMEZONE=
# Adresse de l'API vue du navigateur (web, exposée au client) ; vide : http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=
# Adresse de l'API vue du serveur web (réseau interne) pour la passerelle de My Hub ; vide : NEXT_PUBLIC_API_BASE_URL
API_INTERNAL_URL=
# Clé d'API à portée public:write utilisée par le serveur web pour les devis, adresses et prospects des pages publiques
NEOMOOV_PUBLIC_API_KEY=
# Sites autorisés à intégrer /reserver en iframe (séparés par des espaces) ; vide : https://neomoov.net https://www.neomoov.net
BOOKING_FRAME_ANCESTORS=
# Adresse de l'API pour l'application mobile (publique, fixée par profil dans apps/mobile-client/eas.json) ; vide : http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=
# Répartition automatique des courses : auto (défaut) ou manual (opérateur et tests) ; battement en millisecondes, 0 = aucun
DISPATCH_MODE=
DISPATCH_TICK_MS=

# --- Base de données et Redis ---
# DATABASE_URL : adresse « Session pooler » de Supabase (IPv4), ou base locale (infra/docker-compose.yml)
DATABASE_URL=
# Base de test (schéma dédié ou base séparée) ; vide : les tests d'intégration utilisent DATABASE_URL
TEST_DATABASE_URL=
# Connexions simultanées à la base par processus ; vide : 10 (2 en test). Le « Session pooler » de Supabase limite le total
DATABASE_POOL_MAX=
# Vide : files et cache en mémoire (développement seulement) ; obligatoire en production
REDIS_URL=

# --- Secrets de l'application (obligatoires en production) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# --- Adaptateurs : "mock" ou "real" ---
PAYMENT_PROVIDER=
MAPS_PROVIDER=
SMS_PROVIDER=
EMAIL_PROVIDER=
PUSH_PROVIDER=
WHATSAPP_PROVIDER=
VOICE_PROVIDER=
LLM_PROVIDER=
SEV_PROVIDER=
STORAGE_PROVIDER=
VIRUS_SCANNER_PROVIDER=
CLAMAV_HOST=
CLAMAV_PORT=
# Vérification des jetons Apple et Google : mock (jetons « mock-apple:<sujet>:<courriel> ») ou real
SOCIAL_LOGIN_PROVIDER=

# --- Connexion Apple et Google (audience des jetons d'identité, séparés par des virgules) ---
# Apple : bundle ids des applications (com.neomoov.client, com.neomoov.driver) et identifiant de service web
APPLE_CLIENT_IDS=
# Google : client ids OAuth (iOS, Android, web)
GOOGLE_CLIENT_IDS=
# Nom affiché dans les applications d'authentification pour le second facteur de My Hub ; vide : Neomoov My Hub
MFA_ISSUER=

# --- Paiements (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Cartes (Google Maps Platform) ---
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=

# --- Textos : Telnyx, ou Twilio ---
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Courriels : Resend, ou Brevo ---
# Cloudflare Turnstile : clé secrète (API) et clé de site (pages web, publique)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
BREVO_API_KEY=

# --- WhatsApp Business (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Agent vocal (Vapi) ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER_ID=

# --- Agents IA (Anthropic) ---
ANTHROPIC_API_KEY=
# Repli côté serveur de l'API Claude quand un modèle décline (on par défaut, off pour le couper)
LLM_SERVER_FALLBACK=
# Déclencheurs des agents (messages, documents, relevés, rapports) : on par défaut, off en test sauf le fichier des agents
AGENT_TRIGGERS=
# Test optionnel contre l'API Claude réelle, jamais lancé par défaut : RUN_LLM_TESTS=1 dans l'environnement du test

# --- Stockage des documents : S3 compatible (Supabase Storage), ou Cloudflare R2 ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Observabilité ---
SENTRY_DSN=
BETTERSTACK_TOKEN=

# --- Compilations mobiles (Expo) ---
EXPO_TOKEN=
EXPO_PUSH_ACCESS_TOKEN=

# --- Facturation certifiée (SEV) ---
SEV_API_KEY=

# --- Drapeaux de fonctionnalités : on / off (off par défaut) ---
FEATURE_NEGOTIATION=
FEATURE_NEGOTIATION_ABOVE_MAX=
FEATURE_FACE_CHECK=
FEATURE_SCHEDULED_FLIGHT_TRACKING=
FEATURE_IMMEDIATE_RIDES=
FEATURE_INSTALLMENTS=
FEATURE_RIDE_SERIES=

# --- Outils de test (facultatif) : jeu de bout en bout et charge, voir docs/testing/README.md ---
# pnpm seed:e2e : connexions à la base (défaut 8) et traitements en parallèle (défaut 6)
SEED_E2E_POOL=
SEED_E2E_CONCURRENCY=
# pnpm test:load : chemin du binaire k6 (sinon k6 dans le PATH) ; les paramètres LOAD_* se passent à la commande
K6_BIN=

# Sauvegarde logique chiffrée du serveur (infra/scripts/backup.sh) : phrase secrète et destination rclone facultative
BACKUP_PASSPHRASE=
BACKUP_REMOTE=
