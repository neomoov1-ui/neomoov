# Variables d'environnement de la plateforme Neomoov. Aucune valeur ici.
# Copier en .env (jamais commité) et remplir. Voir la section 3.6 du cahier des charges et
# docs/comptes-externes.md pour l'origine de chaque clé. Une valeur vide équivaut à une variable absente.

# --- Application ---
NODE_ENV=
PORT=
APP_BASE_URL=
WEB_BASE_URL=
# Origines autorisées par CORS, séparées par des virgules ; vide : WEB_BASE_URL seulement
CORS_ORIGINS=
# trace, debug, info (défaut), warn, error, fatal
LOG_LEVEL=
TIMEZONE=
# Adresse de l'API vue du navigateur (web, exposée au client) ; vide : http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=
# Adresse de l'API pour l'application mobile (publique, fixée par profil dans apps/mobile-client/eas.json) ; vide : http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=
# Répartition automatique des courses : auto (défaut) ou manual (opérateur et tests) ; battement en millisecondes, 0 = aucun
DISPATCH_MODE=
DISPATCH_TICK_MS=

# --- Base de données et Redis ---
# DATABASE_URL : adresse « Session pooler » de Supabase (IPv4), ou base locale (infra/docker-compose.yml)
DATABASE_URL=
# Base de test (schéma dédié ou base séparée) ; vide : les tests d'intégration utilisent DATABASE_URL
TEST_DATABASE_URL=
# Connexions simultanées à la base par processus ; vide : 10 (2 en test). Le « Session pooler » de Supabase limite le total
DATABASE_POOL_MAX=
# Vide : files et cache en mémoire (développement seulement) ; obligatoire en production
REDIS_URL=

# --- Secrets de l'application (obligatoires en production) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# --- Adaptateurs : "mock" ou "real" ---
PAYMENT_PROVIDER=
MAPS_PROVIDER=
SMS_PROVIDER=
EMAIL_PROVIDER=
PUSH_PROVIDER=
WHATSAPP_PROVIDER=
VOICE_PROVIDER=
LLM_PROVIDER=
SEV_PROVIDER=
STORAGE_PROVIDER=
# Vérification des jetons Apple et Google : mock (jetons « mock-apple:<sujet>:<courriel> ») ou real
SOCIAL_LOGIN_PROVIDER=

# --- Connexion Apple et Google (audience des jetons d'identité, séparés par des virgules) ---
# Apple : bundle ids des applications (com.neomoov.client, com.neomoov.driver) et identifiant de service web
APPLE_CLIENT_IDS=
# Google : client ids OAuth (iOS, Android, web)
GOOGLE_CLIENT_IDS=
# Nom affiché dans les applications d'authentification pour le second facteur de My Hub ; vide : Neomoov My Hub
MFA_ISSUER=

# --- Paiements (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Cartes (Google Maps Platform) ---
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=

# --- Textos : Telnyx, ou Twilio ---
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Courriels : Resend, ou Brevo ---
RESEND_API_KEY=
BREVO_API_KEY=

# --- WhatsApp Business (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Agent vocal (Vapi) ---
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER_ID=

# --- Agents IA (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Stockage des documents : S3 compatible (Supabase Storage), ou Cloudflare R2 ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Observabilité ---
SENTRY_DSN=
BETTERSTACK_TOKEN=

# --- Compilations mobiles (Expo) ---
EXPO_TOKEN=

# --- Facturation certifiée (SEV) ---
SEV_API_KEY=

# --- Drapeaux de fonctionnalités : on / off (off par défaut) ---
FEATURE_NEGOTIATION=
FEATURE_NEGOTIATION_ABOVE_MAX=
FEATURE_FACE_CHECK=
FEATURE_SCHEDULED_FLIGHT_TRACKING=
FEATURE_IMMEDIATE_RIDES=
FEATURE_INSTALLMENTS=
FEATURE_RIDE_SERIES=
