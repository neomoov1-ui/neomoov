{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.19.0",
      "pnpm": "12.5.1"
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:4000",
        "EAS_PROJECT_ID": "2117c201-6a7a-4f7b-8749-f570a8779a0b"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.neomoov.net",
        "EAS_PROJECT_ID": "2117c201-6a7a-4f7b-8749-f570a8779a0b"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.neomoov.net",
        "EAS_PROJECT_ID": "2117c201-6a7a-4f7b-8749-f570a8779a0b"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "",
        "ascAppId": ""
      },
      "android": {
        "serviceAccountKeyPath": "../../../cles-neomoov/google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
