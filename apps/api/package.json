{
  "name": "@neomoov/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "example:statement": "tsc -p tsconfig.build.json && node --enable-source-maps dist/scripts/example-statement.js",
    "openapi:export": "tsc -p tsconfig.build.json && node --enable-source-maps dist/scripts/export-openapi.js",
    "create-staff": "tsc -p tsconfig.build.json && node --enable-source-maps dist/scripts/create-staff.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@neomoov/db": "workspace:*",
    "@neomoov/domain": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/platform-socket.io": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/websockets": "12.1.0",
    "@sentry/node": "11.0.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "6.3.8",
    "dotenv": "18.0.2",
    "drizzle-orm": "0.45.3",
    "hash-wasm": "4.12.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nanoid": "6.0.1",
    "pdfkit": "0.20.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.0",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  }
}
