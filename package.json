{
  "name": "neomoov",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @neomoov/db db:generate",
    "db:migrate": "pnpm --filter @neomoov/db db:migrate",
    "db:rollback": "pnpm --filter @neomoov/db db:rollback",
    "db:reset": "pnpm --filter @neomoov/db db:reset",
    "db:seed": "pnpm --filter @neomoov/db db:seed"
  },
  "devDependencies": {
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  }
}
