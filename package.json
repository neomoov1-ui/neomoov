{
  "name": "neomoov",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev --filter=@neomoov/api --filter=@neomoov/worker --filter=@neomoov/web",
    "dev:api": "pnpm --filter @neomoov/api dev",
    "dev:worker": "pnpm --filter @neomoov/worker dev",
    "dev:web": "pnpm --filter @neomoov/web dev",
    "dev:client": "pnpm --filter @neomoov/mobile-client dev",
    "dev:driver": "pnpm --filter @neomoov/mobile-driver dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @neomoov/db db:generate",
    "db:migrate": "pnpm --filter @neomoov/db db:migrate",
    "db:rollback": "pnpm --filter @neomoov/db db:rollback",
    "db:reset": "pnpm --filter @neomoov/db db:reset",
    "db:seed": "pnpm --filter @neomoov/db db:seed",
    "seed:e2e": "pnpm --filter @neomoov/api seed:e2e",
    "openapi": "pnpm --filter @neomoov/api-client generate",
    "env:check": "node scripts/env-check.mjs",
    "test:load": "node scripts/load/run-load.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  }
}
